+def _accumulate_channels(flat_indices, values, cells):
+    """Sum each colour channel into its voxel cell.
+
+    ``np.bincount`` per channel is several times faster than a single
+    ``np.add.at`` scatter over the same indices, and gives identical sums.
+    """
+    return np.stack(
+        [
+            np.bincount(flat_indices, weights=values[:, channel], minlength=cells)
+            for channel in range(values.shape[1])
+        ],
+        axis=-1,
+    )
