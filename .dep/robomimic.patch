+    def _bin_points_to_voxel_grid(self, points, colors, bounds_min, bounds_max, resolution):
+        """Build a dense [occupancy, RGB] voxel grid.
+
+        This reproduces Open3D's ``CreateFromPointCloudWithinBounds`` indexing
+        (``floor((p - min_bound) / voxel_size)`` with the same inflated
+        ``voxel_size``) and its per-voxel mean colour, in numpy. Open3D returns
+        one Python object per occupied voxel, which dominated the rollout's
+        per-control-step cost.
+        """
+        res = int(resolution[0])
+        out = np.zeros((4, res, res, res), dtype=np.uint8)
+        points = np.asarray(points, dtype=np.float64)
+        if points.shape[0] == 0:
+            return out
+        bmin = np.asarray(bounds_min, dtype=np.float64)
+        bmax = np.asarray(bounds_max, dtype=np.float64)
+        voxel_size = (bmax[0] - bmin[0]) / res + 1e-4
+        indices = np.floor((points - bmin) / voxel_size).astype(np.int64)
+        valid = np.all((indices >= 0) & (indices < res), axis=-1)
+        if not np.any(valid):
+            return out
+        flat = np.ravel_multi_index(indices[valid].T, (res, res, res))
+        cells = res ** 3
+        counts = np.bincount(flat, minlength=cells)
+        # Open3D averages the [0, 1] colours it was handed, so accumulate in the
+        # same units to match its rounding.
+        unit_colors = np.asarray(colors, dtype=np.float64)[valid] / 255.0
+        color_sum = _accumulate_channels(flat, unit_colors, cells)
+        occupied = counts > 0
+        mean_color = color_sum[occupied] / counts[occupied, None]
+        flat_out = out.reshape(4, -1)
+        flat_out[0, occupied] = 1
+        flat_out[1:, occupied] = np.clip(mean_color.T * 255, 0, 255).astype(np.uint8)
+        return out
+
+    def _bin_centered_points_to_voxel_grid(self, points, colors, bounds_min, bounds_max, resolution):
+        """Build an exact-pitch dense world-aligned local [occupancy, RGB] grid."""
+        shape = tuple(int(value) for value in resolution)
+        out = np.zeros((4, *shape), dtype=np.uint8)
+        if points.shape[0] == 0:
+            return out
+        lower = np.asarray(bounds_min, dtype=np.float64)
+        upper = np.asarray(bounds_max, dtype=np.float64)
+        unit = (points - lower) / (upper - lower)
+        valid = np.all((unit >= 0.0) & (unit < 1.0), axis=-1)
+        if not np.any(valid):
+            return out
+        indices = np.floor(unit[valid] * np.asarray(shape)).astype(np.int64)
+        flat = np.ravel_multi_index(indices.T, shape)
+        cells = int(np.prod(shape))
+        counts = np.bincount(flat, minlength=cells)
+        color_sum = _accumulate_channels(
+            flat, np.asarray(colors, dtype=np.float64)[valid], cells
+        )
+        occupied = counts > 0
+        mean_color = color_sum[occupied] / counts[occupied, None]
+        out.reshape(4, -1)[0, occupied] = 1
+        out.reshape(4, -1)[1:, occupied] = np.clip(mean_color.T, 0, 255).astype(np.uint8)
+        return out
+
+    def _build_point_cloud_observation(self, pcd, bounds_min, bounds_max):
+        """Crop and FPS-sample a fixed-size xyz/RGB point cloud."""
+        num_points = int(self.point_cloud_num_points)
+        bounding_box = o3d.geometry.AxisAlignedBoundingBox(
+            np.asarray(bounds_min, dtype=np.float64), np.asarray(bounds_max, dtype=np.float64)
+        )
+        cropped = pcd.crop(bounding_box)
+        if len(cropped.points) == 0:
+            cropped.points = o3d.utility.Vector3dVector(np.zeros((1, 3)))
+            cropped.colors = o3d.utility.Vector3dVector(np.zeros((1, 3)))
+        if len(cropped.points) < num_points:
+            pad = num_points - len(cropped.points)
+            pad_idx = np.arange(pad, dtype=np.int64) % len(cropped.points)
+            xyz = np.concatenate([np.asarray(cropped.points), np.asarray(cropped.points)[pad_idx]], axis=0)
+            rgb = np.concatenate([np.asarray(cropped.colors), np.asarray(cropped.colors)[pad_idx]], axis=0)
+            cropped.points = o3d.utility.Vector3dVector(xyz)
+            cropped.colors = o3d.utility.Vector3dVector(rgb)
+        sampled = cropped.farthest_point_down_sample(num_points)
+        xyz = np.asarray(sampled.points, dtype=np.float32)
+        rgb01 = np.asarray(sampled.colors, dtype=np.float32)
+        return np.concatenate([xyz, rgb01], axis=-1)
