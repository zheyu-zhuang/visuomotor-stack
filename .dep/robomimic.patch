+    def _unproject_camera_points(self, camera_name, rgb, depth):
+        """Unproject an RGB-D frame into world-frame xyz/RGB points."""
+        depth2d = depth[..., 0]
+        rgb2d = rgb
+        target = self.spatial_recon_resolution
+        if target is not None and target < depth2d.shape[0]:
+            depth2d = cv2.resize(depth2d, (target, target), interpolation=cv2.INTER_AREA)
+            rgb2d = cv2.resize(rgb2d, (target, target), interpolation=cv2.INTER_AREA)
+        mask = depth2d > 0
+        if not np.any(mask):
+            return np.zeros((0, 3)), np.zeros((0, 3), dtype=np.uint8)
+        ys, xs = np.nonzero(mask)
+        z = depth2d[ys, xs].astype(np.float64)
+        height, width = depth2d.shape[:2]
+        K = self.get_camera_intrinsic_matrix(camera_name, height, width)
+        fx, fy, cx, cy = K[0, 0], K[1, 1], K[0, 2], K[1, 2]
+        x_cam = (xs - cx) * z / fx
+        y_cam = (ys - cy) * z / fy
+        cam_pts = np.stack([x_cam, y_cam, z, np.ones_like(z)], axis=-1)
+        camera_to_world = self.get_camera_extrinsic_matrix(camera_name)
+        world_pts = (camera_to_world @ cam_pts.T).T[:, :3]
+        return world_pts, rgb2d[ys, xs]
